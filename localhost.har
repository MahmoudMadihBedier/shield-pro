            "mimeType": "text/javascript",
            "text": "import { RepositoryFactory } from \"/src/infrastructure/database/repository-factory.ts?t=1786819788801\";\nimport { queueOfflineWrite } from \"/src/infrastructure/sync/sync-service.ts\";\nexport class SettingsService {\n  settingRepository = RepositoryFactory.getSettingRepository();\n  async getSetting(key, defaultValue = \"\") {\n    try {\n      const setting = await this.settingRepository.findByKey(key);\n      return setting ? setting.value : defaultValue;\n    } catch {\n      return defaultValue;\n    }\n  }\n  async getSettingBool(key, defaultValue = false) {\n    const val = await this.getSetting(key);\n    if (val === \"\") return defaultValue;\n    return val === \"true\";\n  }\n  async saveSetting(key, value) {\n    try {\n      const existing = await this.settingRepository.findByKey(key);\n      const id = existing?.id || crypto.randomUUID();\n      const updatedRecord = {\n        id,\n        key,\n        value,\n        scope: \"global\",\n        updated_at: (/* @__PURE__ */ new Date()).toISOString()\n      };\n      await this.settingRepository.create(updatedRecord);\n      await queueOfflineWrite(\"settings\", \"insert\", id, updatedRecord);\n    } catch (e) {\n      console.error(\"Failed to save setting:\", e);\n    }\n  }\n  async getAllSettings() {\n    const result = await this.settingRepository.findAll();\n    return result.data;\n  }\n}\n\n//# sourceMappingURL=data:application/json;base64,"
