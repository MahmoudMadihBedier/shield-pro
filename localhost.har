            "mimeType": "text/javascript",
            "text": "import { BaseRepository } from \"/src/infrastructure/database/base-repository.ts?t=1786819788801\";\nexport class PurchaseInvoiceRepository extends BaseRepository {\n  constructor() {\n    super(\"purchase_invoices\");\n  }\n  async findBySupplierId(supplierId) {\n    return await this.table.filter((invoice) => invoice.supplier_id === supplierId).toArray();\n  }\n  async findByDateRange(startDate, endDate) {\n    return await this.table.filter((invoice) => invoice.created_at >= startDate && invoice.created_at <= endDate).toArray();\n  }\n}\n\n//# sourceMappingURL=data:application/json;base64,"
