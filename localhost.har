            "text": "import { BaseRepository } from \"/src/infrastructure/database/base-repository.ts?t=1786819788801\";\nexport class AccountTransactionRepository extends BaseRepository {\n  constructor() {\n    super(\"account_transactions\");\n  }\n  async findByAccountId(accountId) {\n    return await this.table.filter((tx) => tx.account_id === accountId).toArray();\n  }\n  async calculateBalance(accountId) {\n    const transactions = await this.findByAccountId(accountId);\n    return transactions.reduce((sum, tx) => sum + Number(tx.debit) - Number(tx.credit), 0);\n  }\n}\n\n//# sourceMappingURL=data:application/json;base64,"
