            "mimeType": "text/javascript",
            "text": "import { BaseRepository } from \"/src/infrastructure/database/base-repository.ts?t=1786819788801\";\nexport class ItemRepository extends BaseRepository {\n  constructor() {\n    super(\"items\");\n  }\n  async findByType(type) {\n    return await this.table.filter((item) => item.type === type).toArray();\n  }\n  async findByBarcode(barcode) {\n    return await this.table.filter((item) => item.barcode === barcode || item.carton_barcode === barcode).first();\n  }\n  async searchByName(query) {\n    const lowerQuery = query.toLowerCase();\n    return await this.table.filter((item) => item.name.toLowerCase().includes(lowerQuery)).toArray();\n  }\n}\n\n//# sourceMappingURL=data:application/json;base64,"
