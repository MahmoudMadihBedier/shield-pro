            "text": "import { BaseRepository } from \"/src/infrastructure/database/base-repository.ts?t=1786819788801\";\nexport class UserLocationRepository extends BaseRepository {\n  constructor() {\n    super(\"user_locations\");\n  }\n  async findByUserId(userId) {\n    return await this.table.filter((loc) => loc.user_id === userId).toArray();\n  }\n  async findByDateRange(startDate, endDate) {\n    return await this.table.filter((loc) => loc.recorded_at >= startDate && loc.recorded_at <= endDate).toArray();\n  }\n}\n\n//# sourceMappingURL=data:application/json;base64,"
