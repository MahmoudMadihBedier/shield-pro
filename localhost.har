          "content": {
            "size": 11632,
            "mimeType": "text/javascript",
            "text": "import { db } from \"/src/infrastructure/database/dexie.ts\";\nexport class BaseRepository {\n  tableName;\n  constructor(tableName) {\n    this.tableName = tableName;\n  }\n  get table() {\n    return db[this.tableName];\n  }\n  async findById(id) {\n    return await this.table.get(id);\n  }\n  async findAll(filter, params) {\n    let query = this.table.toCollection();\n    if (filter) {\n      for (const [key, value] of Object.entries(filter)) {\n        query = query.filter((item) => item[key] === value);\n      }\n    }\n    const total = await query.count();\n    const page = params?.page || 1;\n    const limit = params?.limit || 50;\n    const offset = (page - 1) * limit;\n    if (params?.sortBy) {\n      const sortOrder = params.sortOrder || \"asc\";\n      const sortBy = params.sortBy;\n      const sortedQuery = query.toArray().then((items) => {\n        return items.sort((a, b) => {\n          const aVal = a[sortBy];\n          const bVal = b[sortBy];\n          if (sortOrder === \"asc\") {\n            return aVal > bVal ? 1 : -1;\n          } else {\n            return aVal < bVal ? 1 : -1;\n          }\n        });\n      });\n      const data2 = await sortedQuery;\n      const paginatedData = data2.slice(offset, offset + limit);\n      return {\n        data: paginatedData,\n        total,\n        page,\n        limit,\n        totalPages: Math.ceil(total / limit)\n      };\n    }\n    const data = await query.offset(offset).limit(limit).toArray();\n    return {\n      data,\n      total,\n      page,\n      limit,\n      totalPages: Math.ceil(total / limit)\n    };\n  }\n  async create(entity) {\n    const id = crypto.randomUUID();\n    const now = (/* @__PURE__ */ new Date()).toISOString();\n    let additionalFields = {};\n    if (this.tableName === \"customers\" && !entity.client_id) {\n      additionalFields.client_id = this.generateClientId();\n    }\n    const newEntity = {\n      ...entity,\n      ...additionalFields,\n      id,\n      created_at: now,\n      updated_at: now\n    };\n    await this.table.put(newEntity);\n    return newEntity;\n  }\n  generateClientId() {\n    const array = new Uint8Array(4);\n    crypto.getRandomValues(array);\n    const hexPart = Array.from(array).map((b) => b.toString(16).padStart(2, \"0\")).join(\"\").toUpperCase().substring(0, 8);\n    return `CLI-${hexPart}`;\n  }\n  async update(id, entity) {\n    const existing = await this.table.get(id);\n    if (!existing) {\n      throw new Error(`Entity with id ${id} not found`);\n    }\n    const updatedEntity = {\n      ...existing,\n      ...entity,\n      updated_at: (/* @__PURE__ */ new Date()).toISOString()\n    };\n    await this.table.put(updatedEntity);\n    return updatedEntity;\n  }\n  async delete(id) {\n    await this.table.delete(id);\n  }\n  async count(filter) {\n    let query = this.table.toCollection();\n    if (filter) {\n      for (const [key, value] of Object.entries(filter)) {\n        query = query.filter((item) => item[key] === value);\n      }\n    }\n    return await query.count();\n  }\n}\n\n//# sourceMappingURL=data:application/json;base64,"
          },
