            "text": "import { BaseRepository } from \"/src/infrastructure/database/base-repository.ts?t=1786819788801\";\nexport class AccountRepository extends BaseRepository {\n  constructor() {\n    super(\"accounts\");\n  }\n  async findByCategory(category) {\n    return await this.table.filter((account) => account.category === category).toArray();\n  }\n  async findByCode(code) {\n    return await this.table.filter((account) => account.code === code).first();\n  }\n}\n\n//# sourceMappingURL=data:application/json;base64,"
