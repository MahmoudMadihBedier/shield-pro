            "mimeType": "text/javascript",
            "text": "import { RepositoryFactory } from \"/src/infrastructure/database/repository-factory.ts?t=1786819788801\";\nexport class DashboardService {\n  salesInvoiceRepository = RepositoryFactory.getSalesInvoiceRepository();\n  accountTransactionRepository = RepositoryFactory.getAccountTransactionRepository();\n  itemRepository = RepositoryFactory.getItemRepository();\n  stockMovementRepository = RepositoryFactory.getStockMovementRepository();\n  async getTodaySales() {\n    const todayStr = (/* @__PURE__ */ new Date()).toISOString().split(\"T\")[0];\n    const invoices = await this.salesInvoiceRepository.findAll();\n    return invoices.data.filter((inv) => inv.date === todayStr).reduce((sum, inv) => sum + Number(inv.total), 0);\n  }\n  async getCashBankBalance() {\n    const accounts = await this.accountTransactionRepository.findAll();\n    const cashBankAccounts = await RepositoryFactory.getAccountRepository().findByCategory(\"cash\") || [];\n    const bankAccounts = await RepositoryFactory.getAccountRepository().findByCategory(\"bank\") || [];\n    const cashBankIds = [...cashBankAccounts, ...bankAccounts].map((a) => a.id);\n    return accounts.data.filter((tx) => cashBankIds.includes(tx.account_id)).reduce((sum, tx) => sum + Number(tx.debit) - Number(tx.credit), 0);\n  }\n  async getLowStockCount() {\n    const items = await this.itemRepository.findAll();\n    let lowCount = 0;\n    for (const item of items.data) {\n      const stock = await this.stockMovementRepository.calculateStock(item.id);\n      if (stock <= item.reorder_level) {\n        lowCount++;\n      }\n    }\n    return lowCount;\n  }\n  async getPendingSyncCount() {\n    const { db } = await import(\"/src/infrastructure/database/dexie.ts\");\n    return await db.offline_queue.count();\n  }\n  async getDashboardStats() {\n    const [todaySales, cashBank, lowStockCount, pendingSync] = await Promise.all([\n      this.getTodaySales(),\n      this.getCashBankBalance(),\n      this.getLowStockCount(),\n      this.getPendingSyncCount()\n    ]);\n    return {\n      todaySales,\n      cashBank,\n      lowStockCount,\n      pendingSync\n    };\n  }\n  async getLowStockItems(limit = 5) {\n    const items = await this.itemRepository.findAll();\n    const lowStockItems = [];\n    for (const item of items.data) {\n      const stock = await this.stockMovementRepository.calculateStock(item.id);\n      if (stock <= item.reorder_level) {\n        lowStockItems.push({ ...item, currentStock: stock });\n      }\n    }\n    return lowStockItems.slice(0, limit);\n  }\n}\n\n//# sourceMappingURL=data:application/json;base64,"
