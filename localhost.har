            "mimeType": "text/javascript",
            "text": "import { BaseRepository } from \"/src/infrastructure/database/base-repository.ts?t=1786819788801\";\nexport class StockMovementRepository extends BaseRepository {\n  constructor() {\n    super(\"stock_movements\");\n  }\n  async findByItemId(itemId) {\n    return await this.table.filter((movement) => movement.item_id === itemId).toArray();\n  }\n  async findByWarehouseId(warehouseId) {\n    return await this.table.filter((movement) => movement.warehouse_id === warehouseId).toArray();\n  }\n  async calculateStock(itemId, warehouseId) {\n    const movements = warehouseId ? await this.table.filter((m) => m.item_id === itemId && m.warehouse_id === warehouseId).toArray() : await this.table.filter((m) => m.item_id === itemId).toArray();\n    return movements.reduce((sum, m) => sum + Number(m.qty), 0);\n  }\n}\n\n//# sourceMappingURL=data:application/json;base64,"
