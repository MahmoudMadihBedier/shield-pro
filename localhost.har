            "text": "import { BaseRepository } from \"/src/infrastructure/database/base-repository.ts?t=1786819788801\";\nexport class AttendanceRepository extends BaseRepository {\n  constructor() {\n    super(\"attendance\");\n  }\n  async findByEmployeeId(employeeId) {\n    return await this.table.filter((attendance) => attendance.employee_id === employeeId).toArray();\n  }\n  async findByDateRange(startDate, endDate) {\n    return await this.table.filter((attendance) => attendance.date >= startDate && attendance.date <= endDate).toArray();\n  }\n}\n\n//# sourceMappingURL=data:application/json;base64,"
