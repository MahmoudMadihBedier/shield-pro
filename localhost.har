            "mimeType": "text/javascript",
            "text": "import { queueOfflineWrite } from \"/src/infrastructure/sync/sync-service.ts\";\nexport async function postDoubleEntry({\n  refTable,\n  refId,\n  debitAccountId,\n  creditAccountId,\n  amount,\n  date\n}) {\n  const txDate = date ?? (/* @__PURE__ */ new Date()).toISOString().split(\"T\")[0];\n  const debitId = crypto.randomUUID();\n  await queueOfflineWrite(\"account_transactions\", \"insert\", debitId, {\n    id: debitId,\n    account_id: debitAccountId,\n    ref_table: refTable,\n    ref_id: refId,\n    debit: amount,\n    credit: 0,\n    date: txDate\n  });\n  const creditId = crypto.randomUUID();\n  await queueOfflineWrite(\"account_transactions\", \"insert\", creditId, {\n    id: creditId,\n    account_id: creditAccountId,\n    ref_table: refTable,\n    ref_id: refId,\n    debit: 0,\n    credit: amount,\n    date: txDate\n  });\n}\n\n//# sourceMappingURL=data:application/json;base64,"
